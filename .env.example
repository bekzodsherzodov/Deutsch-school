# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring.
# .env hech qachon GitHub'ga yuklanmaydi (.gitignore'da).
PORT=3000
NODE_ENV=production
# Uzun tasodifiy qator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Birinchi ishga tushishda administrator shu ma'lumot bilan yaratiladi
ADMIN_USER=
ADMIN_PASSWORD=
# Ma'lumotlar bazasi fayli (deploy'da doimiy disk yo'li bo'lishi shart)
DB_PATH=./data/school.db
